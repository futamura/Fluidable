default_platform(:ios)

require "fileutils"
require_relative "ios_simulator_destination"

project_name = ENV.fetch("PROJECT_NAME", "Fluidable")
repo_root = File.expand_path("..", __dir__)
xcodeproj_framework = ENV.fetch("XCODEPROJ_FRAMEWORK", "#{project_name}.xcodeproj")
scheme_ios = ENV.fetch("SCHEME_IOS", project_name)
ios_simulator_triple = "arm64-apple-ios15.0-simulator"
coverage_result_bundle = File.join(repo_root, "Reports", "coverage", "#{project_name}.xcresult")
coverage_report_path = File.join(repo_root, "Reports", "coverage", "xccov.txt")
docc_output_path = File.join(repo_root, "docs")
docc_hosting_base_path = ENV.fetch("DOCC_HOSTING_BASE_PATH", project_name)

def ios_destination
  ENV.fetch("IOS_DESTINATION") { IOSSimulatorDestination.destination }
end

def clean_generated_docs(repo_root)
  docs_dir = File.join(repo_root, "docs")
  FileUtils.mkdir_p(docs_dir)
  FileUtils.rm_rf(Dir.children(docs_dir).map { |entry| File.join(docs_dir, entry) })
end

platform :ios do
  desc "Run SwiftPM build, coverage-enabled Xcode unit tests, and SwiftLint"
  lane :test do
    Dir.chdir(repo_root) do
      sh("swift package resolve")
      sdk_path = sh("xcrun --sdk iphonesimulator --show-sdk-path").strip
      sh("swift build --sdk '#{sdk_path}' --triple #{ios_simulator_triple}")
      UI.message("Using iOS simulator destination: #{ios_destination}")
      sh("xcodebuild build-for-testing -project #{xcodeproj_framework} -scheme #{scheme_ios} -destination '#{ios_destination}' CODE_SIGNING_ALLOWED=NO")
    end
    coverage
    lint
  end

  desc "Run Xcode coverage and export an xccov text report"
  lane :coverage do
    Dir.chdir(repo_root) do
      FileUtils.mkdir_p(File.dirname(coverage_result_bundle))
      FileUtils.rm_rf(coverage_result_bundle)
      FileUtils.rm_f(coverage_report_path)
      UI.message("Using iOS simulator destination: #{ios_destination}")
      sh("xcodebuild test -project #{xcodeproj_framework} -scheme #{scheme_ios} -destination '#{ios_destination}' -enableCodeCoverage YES -resultBundlePath '#{coverage_result_bundle}' CODE_SIGNING_ALLOWED=NO")
      sh("xcrun xccov view --report '#{coverage_result_bundle}' > '#{coverage_report_path}'")
    end
  end

  desc "Run SwiftLint"
  lane :lint do
    Dir.chdir(repo_root) do
      sh("swiftlint lint --config .swiftlint.yml Sources")
    end
  end

  desc "Create DocC documentation"
  lane :create_doc do
    Dir.chdir(repo_root) do
      clean_generated_docs(repo_root)
      sdk_path = sh("xcrun --sdk iphonesimulator --show-sdk-path").strip
      sh("swift package --sdk '#{sdk_path}' --triple #{ios_simulator_triple} --allow-writing-to-directory '#{docc_output_path}' generate-documentation --target #{project_name} --output-path '#{docc_output_path}' --transform-for-static-hosting --hosting-base-path #{docc_hosting_base_path}")
      FileUtils.touch(File.join(docc_output_path, ".nojekyll"))
    end
  end

  desc "Reset Simulator"
  lane :reset_simulator do
    reset_simulator_contents
  end

  desc "Reset Derived Data"
  lane :reset_derived_data do
    clear_derived_data
  end

  desc "Remove .DS_Store"
  lane :remove_ds_store do
    Dir.chdir(repo_root) do
      sh("find . -name '.DS_Store' -delete")
    end
  end
end
