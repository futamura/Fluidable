default_platform(:ios)

require "fileutils"
require "tmpdir"

project_name = ENV.fetch("PROJECT_NAME", "Fluidable")
repo_root = File.expand_path("..", __dir__)
xcodeproj_framework = ENV.fetch("XCODEPROJ_FRAMEWORK", "#{project_name}.xcodeproj")
scheme_ios = ENV.fetch("SCHEME_IOS", project_name)
ios_destination = "platform=iOS Simulator,name=iPhone 17,OS=26.5"
ios_simulator_triple = "arm64-apple-ios15.0-simulator"

def preserve_docs_sidecars(repo_root)
  preserved = %w[docs/memory docs/superpowers].select do |path|
    File.directory?(File.join(repo_root, path))
  end

  Dir.mktmpdir("fluidable-jazzy-sidecars") do |tmpdir|
    preserved.each do |path|
      source = File.join(repo_root, path)
      backup = File.join(tmpdir, path)
      FileUtils.mkdir_p(File.dirname(backup))
      FileUtils.cp_r(source, backup)
    end

    begin
      yield
    ensure
      preserved.each do |path|
        backup = File.join(tmpdir, path)
        target = File.join(repo_root, path)
        next unless File.exist?(backup)

        FileUtils.mkdir_p(File.dirname(target))
        FileUtils.rm_rf(target)
        FileUtils.cp_r(backup, target)
      end
    end
  end
end

platform :ios do
  desc "Run SwiftPM build and Xcode unit tests"
  lane :test do
    Dir.chdir(repo_root) do
      sh("swift package resolve")
      sdk_path = sh("xcrun --sdk iphonesimulator --show-sdk-path").strip
      sh("swift build --sdk '#{sdk_path}' --triple #{ios_simulator_triple}")
      sh("xcodebuild build-for-testing -project #{xcodeproj_framework} -scheme #{scheme_ios} -destination '#{ios_destination}' CODE_SIGNING_ALLOWED=NO")
      sh("xcodebuild test -project #{xcodeproj_framework} -scheme #{scheme_ios} -destination '#{ios_destination}' -only-testing:FluidableTests CODE_SIGNING_ALLOWED=NO")
    end
    lint
  end

  desc "Run Coverage"
  lane :coverage do
    Dir.chdir(repo_root) do
      slather(
        html: true,
        verbose: true,
        show: true,
      )
    end
  end

  desc "Run SwiftLint"
  lane :lint do
    Dir.chdir(repo_root) do
      sh("swiftlint lint --config .swiftlint.yml Sources")
    end
  end

  desc "Create documentation"
  lane :create_doc do
    Dir.chdir(repo_root) do
      preserve_docs_sidecars(repo_root) do
        sh("jazzy --config #{File.join(repo_root, ".jazzy.yml")}")
        sh("find docs -name '*.html' -exec sed -i '' -e 's/[[:blank:]]*$//' {} +")
      end
    end
  end

  desc "Reset Simulator"
  lane :reset_simulator do
    reset_simulator_contents
  end

  desc "Reset Derived Data"
  lane :reset_derived_data do
    clear_derived_data
  end

  desc "Remove .DS_Store"
  lane :remove_ds_store do
    Dir.chdir(repo_root) do
      sh("find . -name '.DS_Store' -delete")
    end
  end
end
